<%- include('partials/head') %>
<body class="bg-surface-stone text-on-surface font-body-md selection:bg-tsubaki-red/10">

<%- include('partials/nav') %>

<!-- Hero -->
<section class="relative min-h-screen flex items-center overflow-hidden pt-20">
  <div class="absolute inset-0 z-0">
    <img id="hero-img"
      class="w-full h-full object-cover grayscale-[20%] brightness-95"
      src="https://lh3.googleusercontent.com/aida-public/AB6AXuCdSuGZ1dG3njptiDzP3CcddDaKbRFuf1Ckl5yaPQaIoV7GDA26vg_La2T_pt8LljlT8USQIDNZoWQ17XC2mIABsGGDFvic5eT8-2IrezooPyUmNylNuPlpuKYLocVotTfGF7lHvAg_E75ZLxjVAm7a67nNr-0Avl7lX9jWFt9vAXDrPHihkIo0-I6enwC7lwXM6eH4ERKmx7M-oG4J1VpmD8oL2nvSRH3panh4oMC7FJjs-Qhkwbaxt-9EZUcQJFtRxxRZwuWZjT-d"
      alt="Serene Japanese Zen garden">
    <div class="absolute inset-0 bg-gradient-to-r from-surface-stone/80 via-surface-stone/40 to-transparent"></div>
  </div>
  <div class="relative z-10 max-w-max-width-desktop mx-auto px-gutter w-full">
    <div class="max-w-2xl">
      <span class="inline-block px-4 py-1 rounded-full bg-tsubaki-red/10 text-tsubaki-red font-label-md text-label-md mb-md">
        <%= t('index.hero_badge') %>
      </span>
      <h1 class="font-display text-display-mobile md:text-display text-charcoal-text mb-md leading-tight">
        <%= t('index.hero_title1') %> <br>
        <span class="text-tsubaki-red"><%= t('index.hero_title2') %></span>
      </h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant mb-lg leading-relaxed max-w-lg">
        <%= t('index.hero_desc') %>
      </p>
      <div class="flex flex-col sm:flex-row gap-md">
        <a href="/register" class="bg-tsubaki-red text-on-primary px-8 py-4 rounded-lg font-label-md text-body-md shadow-lg hover:shadow-xl transition-all active:scale-95 flex items-center justify-center gap-base">
          <%= t('index.hero_start') %>
          <span class="material-symbols-outlined">arrow_forward</span>
        </a>
        <a href="#about" class="bg-surface-lowest text-charcoal-text border border-outline-variant/50 px-8 py-4 rounded-lg font-label-md text-body-md hover:bg-surface-stone transition-all active:scale-95 text-center">
          <%= t('index.hero_learn_more') %>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Personalized Path -->
<section id="path" class="ma-whitespace bg-surface-lowest">
  <div class="max-w-max-width-desktop mx-auto px-gutter text-center scroll-reveal">
    <div class="max-w-3xl mx-auto">
      <h2 class="font-h2 text-h1 md:text-display-mobile text-charcoal-text mb-lg"><%= t('index.ai_path_title') %></h2>
      <div class="w-16 h-1 bg-tsubaki-red mx-auto mb-lg opacity-30"></div>
      <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed mb-xl">
        <%= t('index.ai_path_desc') %>
      </p>
      <div class="grid md:grid-cols-3 gap-lg text-left mt-xl">
        <div class="p-lg rounded-xl transition-all duration-500 hover:bg-surface-stone/50">
          <span class="material-symbols-outlined text-tsubaki-red text-4xl mb-md" style="font-variation-settings: 'FILL' 0;">query_stats</span>
          <h3 class="font-h2 text-h2 mb-base"><%= t('index.ai_path_step1_title') %></h3>
          <p class="font-body-md text-body-md text-on-surface-variant"><%= t('index.ai_path_step1_desc') %></p>
        </div>
        <div class="p-lg rounded-xl transition-all duration-500 hover:bg-surface-stone/50">
          <span class="material-symbols-outlined text-tsubaki-red text-4xl mb-md" style="font-variation-settings: 'FILL' 0;">route</span>
          <h3 class="font-h2 text-h2 mb-base"><%= t('index.ai_path_step2_title') %></h3>
          <p class="font-body-md text-body-md text-on-surface-variant"><%= t('index.ai_path_step2_desc') %></p>
        </div>
        <div class="p-lg rounded-xl transition-all duration-500 hover:bg-surface-stone/50">
          <span class="material-symbols-outlined text-tsubaki-red text-4xl mb-md" style="font-variation-settings: 'FILL' 0;">monitoring</span>
          <h3 class="font-h2 text-h2 mb-base"><%= t('index.ai_path_step3_title') %></h3>
          <p class="font-body-md text-body-md text-on-surface-variant"><%= t('index.ai_path_step3_desc') %></p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 4 Skills AI Features -->
<section id="features" class="ma-whitespace bg-surface-stone relative overflow-hidden">
  <div class="absolute top-0 right-0 w-96 h-96 bg-sumire-purple/5 rounded-full blur-[120px]"></div>
  <div class="absolute bottom-0 left-0 w-96 h-96 bg-tsubaki-red/5 rounded-full blur-[120px]"></div>
  <div class="max-w-max-width-desktop mx-auto px-gutter relative z-10 scroll-reveal">
    <div class="grid lg:grid-cols-2 gap-xl items-center">
      <div class="order-2 lg:order-1">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-md">
          <div class="glass-purple p-lg rounded-xl ai-border-gradient">
            <span class="material-symbols-outlined text-sumire-purple mb-base">headphones</span>
            <h4 class="font-h2 text-body-lg font-bold mb-xs"><%= t('index.skill_listen_title') %></h4>
            <p class="font-body-md text-caption opacity-80"><%= t('index.skill_listen_desc') %></p>
          </div>
          <div class="glass-purple p-lg rounded-xl ai-border-gradient translate-y-base">
            <span class="material-symbols-outlined text-sumire-purple mb-base">mic</span>
            <h4 class="font-h2 text-body-lg font-bold mb-xs"><%= t('index.skill_speak_title') %></h4>
            <p class="font-body-md text-caption opacity-80"><%= t('index.skill_speak_desc') %></p>
          </div>
          <div class="glass-purple p-lg rounded-xl ai-border-gradient">
            <span class="material-symbols-outlined text-sumire-purple mb-base">menu_book</span>
            <h4 class="font-h2 text-body-lg font-bold mb-xs"><%= t('index.skill_read_title') %></h4>
            <p class="font-body-md text-caption opacity-80"><%= t('index.skill_read_desc') %></p>
          </div>
          <div class="glass-purple p-lg rounded-xl ai-border-gradient translate-y-base">
            <span class="material-symbols-outlined text-sumire-purple mb-base">edit</span>
            <h4 class="font-h2 text-body-lg font-bold mb-xs"><%= t('index.skill_write_title') %></h4>
            <p class="font-body-md text-caption opacity-80"><%= t('index.skill_write_desc') %></p>
          </div>
        </div>
      </div>
      <div class="order-1 lg:order-2">
        <h2 class="font-display text-headline-lg md:text-display text-charcoal-text mb-md leading-tight">
          <%= t('index.ai_title1') %> <span class="text-gradient-ai"><%= t('index.ai_sensei') %></span>
        </h2>
        <p class="font-body-lg text-body-lg text-on-surface-variant mb-lg leading-relaxed">
          <%= t('index.ai_desc') %>
        </p>
        <div class="bg-surface-lowest p-md rounded-lg border border-outline-variant/30 inline-flex items-center gap-base animate-pulse-soft">
          <div class="w-3 h-3 rounded-full bg-sumire-purple shadow-[0_0_10px_rgba(113,42,226,0.6)]"></div>
          <span class="font-label-md text-label-md text-sumire-purple font-semibold uppercase tracking-wider"><%= t('index.ai_active') %></span>
        </div>
      </div>
    </div>
  </div>
</section>

 

<!-- Testimonials -->
<section class="ma-whitespace bg-surface-stone border-y border-outline-variant/10">
  <div class="max-w-max-width-desktop mx-auto px-gutter scroll-reveal">
    <div class="text-center mb-xl">
      <p class="font-label-md text-label-md text-on-surface-variant uppercase tracking-widest mb-md"><%= t('index.trusted_by') %></p>
      <div class="flex flex-wrap justify-center items-center gap-xl opacity-40 grayscale">
        <span class="font-display font-bold text-h2">NIKKEI</span>
        <span class="font-display font-bold text-h2">NHK</span>
        <span class="font-display font-bold text-h2">ASAHI</span>
        <span class="font-display font-bold text-h2">YOMIURI</span>
      </div>
    </div>
    <div class="grid md:grid-cols-3 gap-lg">
      <% testimonials.forEach(item => { %>
      <div class="bg-surface-lowest p-lg rounded-xl shadow-sm border border-outline-variant/10">
        <div class="flex gap-xs mb-md">
          <% for(let i = 0; i < 5; i++) { %>
          <span class="material-symbols-outlined text-tsubaki-red" style="font-variation-settings: 'FILL' 1;">star</span>
          <% } %>
        </div>
        <p class="font-body-md text-on-surface italic mb-lg leading-relaxed">"<%= item.text %>"</p>
        <div class="flex items-center gap-base">
          <div class="w-10 h-10 rounded-full bg-surface-variant flex items-center justify-center text-on-surface-variant font-bold">
            <%= item.name.charAt(0) %>
          </div>
          <div>
            <div class="font-label-md text-label-md font-bold"><%= item.name %></div>
            <div class="font-caption text-caption text-on-surface-variant"><%= item.level %></div>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- Final CTA -->
<section class="relative ma-whitespace bg-surface-lowest overflow-hidden">
  <!-- 3D Bridge Background -->
  <div class="absolute inset-0 z-0">
    <img src="/images/bridge.png" alt="Bridge between Japan and Vietnam" class="w-full h-full object-cover opacity-80">
    <div class="absolute inset-0 bg-surface-stone/70 backdrop-blur-[2px]"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-surface-lowest via-surface-lowest/50 to-transparent"></div>
  </div>

  <div class="max-w-max-width-desktop mx-auto px-gutter text-center relative z-10 scroll-reveal">
    <div class="max-w-3xl mx-auto py-xl px-md md:px-xl rounded-3xl bg-surface-lowest/90 backdrop-blur-md border border-outline-variant/30 shadow-2xl relative overflow-hidden">
      <div class="absolute -top-12 -right-12 w-48 h-48 bg-tsubaki-red/20 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-12 -left-12 w-48 h-48 bg-sumire-purple/20 rounded-full blur-3xl"></div>
      <h2 class="font-h2 text-h1 md:text-headline-lg text-charcoal-text mb-md drop-shadow-sm"><%= t('index.cta_title') %></h2>
      <p class="font-body-md text-body-lg text-on-surface-variant mb-lg font-medium">
        <%= t('index.cta_desc') %>
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-md mt-xl">
        <a href="/register" class="bg-tsubaki-red text-on-primary px-10 py-4 rounded-full font-label-md text-body-md shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all active:scale-95"><%= t('index.cta_join') %></a>
        <a href="/register?trial=true" class="bg-surface-stone text-charcoal-text border border-outline px-10 py-4 rounded-full font-label-md text-body-md hover:bg-surface-variant transition-all active:scale-95"><%= t('index.cta_trial') %></a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>

<script src="/js/main.js"></script>
</body>
</html>
