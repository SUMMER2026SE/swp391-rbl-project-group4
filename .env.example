# ══════════════════════════════════════════════════════════════════════════════
# Kizuna Nihongo — biến môi trường BACKEND
# Local: copy file này thành `.env` (đặt ở thư mục gốc repo — server.js đọc ../.env).
# Deploy: điền từng biến vào Environment Variables của Render/Railway (KHÔNG upload file).
# .env thật đã bị .gitignore chặn — đừng commit.
# ══════════════════════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────── BẮT BUỘC ────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# BÍ MẬT: service role bypass mọi RLS. Chỉ để ở backend, không bao giờ đưa ra frontend.
SUPABASE_SERVICE_ROLE_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
# URL frontend — dùng cho CORS. Deploy: https://<ten-app>.vercel.app
FRONTEND_URL=http://localhost:5173
# CHỈ dùng khi chạy local. Trên Render/Railway KHÔNG set (host tự cấp PORT).
API_PORT=3001

# ── AI (FPT Cloud Marketplace) ────────────────────────────── BẮT BUỘC ────────
FPT_AI_API_KEY=
FPT_AI_MODEL=
FPT_AI_WHISPER_MODEL=
FPT_AI_JLPT_MODEL=

# ── Email OTP (SMTP) ──────────────────────────────────────── BẮT BUỘC ────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Thanh toán SePay ──────────────────────────────────────── BẮT BUỘC ────────
# BÍ MẬT: SEPAY_WEBHOOK_KEY dùng xác thực webhook (sai chữ ký là từ chối).
SEPAY_API_TOKEN=
SEPAY_WEBHOOK_KEY=
PAYMENT_PROVIDER=sepay
QR_PROVIDER=sepay
QR_BANK_CODE=
QR_ACCOUNT_NUMBER=
PAYMENT_ORDER_EXPIRE_MINUTES=30
SUBSCRIPTION_DURATION_DAYS=30

# ── Tuỳ chọn (có giá trị mặc định trong code) ─────────────────────────────────
# Tiền tố nội dung chuyển khoản: gói Premium (mặc định PREM) / mua khoá học (mặc định COURSE)
TRANSFER_CONTENT_PREFIX=PREM
COURSE_TRANSFER_CONTENT_PREFIX=COURSE
# Chỉ cần cho các script seed dữ liệu trong backend/scripts — runtime không dùng.
SUPABASE_DB_URL=
