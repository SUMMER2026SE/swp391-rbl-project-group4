# Frontend Kizuna Nihongo — copy thành .env (local) hoặc điền vào Environment Variables của Vercel.
# Lưu ý: mọi biến VITE_* đều được nhúng vào bundle và CÔNG KHAI trên trình duyệt.
# Chỉ dùng anon key ở đây, KHÔNG bao giờ đặt service role key hay SEPAY_* vào file này.

VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
