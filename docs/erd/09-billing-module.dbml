// 09-billing-module.dbml — schema "billing_module" (Thanh toán & gói cước)
// Kizuna Nihongo — dán trực tiếp vào https://dbdiagram.io

Table billing_module.content_usage_events {
  id uuid [pk, default: `gen_random_uuid()`]
  student_id uuid [not null]
  content_type text [not null]
  content_id uuid [not null]
  teacher_id uuid [not null]
  used_at timestamptz [not null, default: `now()`]
  period_key text [not null]
  day_key date [not null, default: `CURRENT_DATE`]
}

Table billing_module.course_payment_orders {
  id uuid [pk, default: `gen_random_uuid()`]
  student_id uuid [not null]
  course_id uuid [not null]
  order_code text [unique, not null]
  payment_code text [unique, not null]
  amount numeric(12,2) [not null]
  currency text [not null, default: 'VND']
  provider text [not null, default: 'sepay']
  bank_code text
  account_number text
  qr_url text
  status text [not null, default: 'pending']
  expires_at timestamptz [not null]
  paid_at timestamptz
  matched_transaction_id text
  matched_reference_number text
  matched_transaction_time timestamptz
  raw_match_payload jsonb
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table billing_module.feature_entitlements {
  id uuid [pk, default: `gen_random_uuid()`]
  tier text [not null]
  feature_code text [not null]
  limit_value int [not null, default: '-1']
  period_type text [not null]
  metadata_json jsonb [not null, default: '{}']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (tier, feature_code) [unique]
  }
}

Table billing_module.feature_usage_counters {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  feature_code text [not null]
  period_type text [not null]
  period_key text [not null]
  used_count int [not null, default: 0]
  used_amount numeric [not null, default: 0]
  tier_at_time text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, feature_code, period_key) [unique]
  }
}

Table billing_module.payment_orders {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  plan_id uuid [not null]
  order_code text [unique, not null]
  payment_code text [unique, not null]
  amount numeric(12,2) [not null]
  currency text [not null, default: 'VND']
  provider text [not null, default: 'sepay']
  bank_code text
  account_number text
  qr_url text
  status text [not null, default: 'pending']
  expires_at timestamptz [not null]
  paid_at timestamptz
  matched_transaction_id text
  matched_reference_number text
  matched_transaction_time timestamptz
  raw_match_payload jsonb
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table billing_module.payment_transactions {
  id uuid [pk, default: `gen_random_uuid()`]
  provider text [not null, default: 'sepay']
  external_transaction_id text
  reference_number text
  account_number text
  bank_brand_name text
  amount_in numeric(12,2)
  amount_out numeric(12,2)
  transaction_content text
  transaction_date timestamptz
  raw_payload jsonb
  matched_order_id uuid
  created_at timestamptz [not null, default: `now()`]
  matched_course_order_id uuid

  indexes {
    (provider, external_transaction_id) [unique]
  }
}

Table billing_module.payments {
  id uuid [pk, default: `gen_random_uuid()`]
  student_id uuid [not null]
  course_id uuid [not null]
  amount numeric(12,2) [not null]
  platform_fee numeric(12,2) [not null]
  teacher_payout numeric(12,2) [not null]
  payment_status varchar(20) [default: 'pending']
  payment_provider varchar(20)
  provider_transaction_id text
  created_at timestamptz [default: `now()`]
}

Table billing_module.revenue_pool_periods {
  period_key text [pk]
  total_vip_revenue numeric [not null, default: 0]
  pool_pct numeric [not null]
  pool_amount numeric [not null, default: 0]
  total_uses int [not null, default: 0]
  status text [not null, default: 'finalized']
  finalized_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

Table billing_module.subscription_plans {
  id uuid [pk, default: `gen_random_uuid()`]
  code text [unique, not null]
  name text [not null]
  tier text [not null]
  billing_cycle text [not null, default: 'none']
  price numeric(12,2) [not null, default: 0]
  currency text [not null, default: 'VND']
  is_active boolean [not null, default: true]
  features_json jsonb [not null, default: '{}']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table billing_module.teacher_payouts {
  id uuid [pk, default: `gen_random_uuid()`]
  period_key text [not null]
  teacher_id uuid [not null]
  uses int [not null, default: 0]
  share_pct numeric [not null, default: 0]
  amount numeric [not null, default: 0]
  status text [not null, default: 'pending']
  created_at timestamptz [not null, default: `now()`]
  paid_at timestamptz

  indexes {
    (period_key, teacher_id) [unique]
  }
}

Table billing_module.user_subscriptions {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  plan_id uuid [not null]
  tier text [not null, default: 'free']
  status text [not null, default: 'active']
  started_at timestamptz [not null, default: `now()`]
  current_period_start timestamptz
  current_period_end timestamptz
  expired_at timestamptz
  auto_renew boolean [not null, default: false]
  source text [not null, default: 'manual']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// ─── Bảng tham chiếu ở schema khác (stub, chỉ để vẽ quan hệ) ───

Table auth.users {
  id uuid [pk]

  Note: 'Supabase Auth (auth.users) — nguồn định danh gốc'
}

Table course_module.courses {
  id uuid [pk]

  Note: 'Bảng thuộc schema course_module — xem file 02-course-module.dbml'
}

Table users_module.users {
  id uuid [pk]

  Note: 'Bảng thuộc schema users_module — xem file 01-users-module.dbml'
}

// ─── Quan hệ ───

Ref: billing_module.course_payment_orders.student_id > users_module.users.id
Ref: billing_module.course_payment_orders.course_id > course_module.courses.id
Ref: billing_module.feature_usage_counters.user_id > auth.users.id
Ref: billing_module.payment_orders.user_id > auth.users.id
Ref: billing_module.payment_orders.plan_id > billing_module.subscription_plans.id
Ref: billing_module.payment_transactions.matched_course_order_id > billing_module.course_payment_orders.id
Ref: billing_module.payment_transactions.matched_order_id > billing_module.payment_orders.id
Ref: billing_module.payments.course_id > course_module.courses.id
Ref: billing_module.payments.student_id > users_module.users.id
Ref: billing_module.user_subscriptions.plan_id > billing_module.subscription_plans.id
Ref: billing_module.user_subscriptions.user_id > auth.users.id
