  id smallint [pk]

  Note: 'Bảng thuộc schema language_module — xem file 03-language-module.dbml'
}

Table language_module.kanji {
  id uuid [pk]

  Note: 'Bảng thuộc schema language_module — xem file 03-language-module.dbml'
}

Table language_module.vocabulary {
  id uuid [pk]

  Note: 'Bảng thuộc schema language_module — xem file 03-language-module.dbml'
}

Table practice_module.articles {
  id uuid [pk]

  Note: 'Bảng thuộc schema practice_module — xem file 04-practice-module.dbml'
}

Table users_module.users {
  id uuid [pk]

  Note: 'Bảng thuộc schema users_module — xem file 01-users-module.dbml'
}

// ─── Quan hệ ───

Ref: course_module.course_enrollments.course_id > course_module.courses.id
Ref: course_module.course_enrollments.student_id > users_module.users.id
Ref: course_module.course_reviews.student_id > users_module.users.id
Ref: course_module.course_reviews.course_id > course_module.courses.id
Ref: course_module.courses.jlpt_level_id > language_module.jlpt_levels.id
Ref: course_module.courses.skill_id > course_module.skills.id
Ref: course_module.courses.created_by > users_module.users.id
Ref: course_module.lesson_grammar.lesson_id > course_module.lessons.id
Ref: course_module.lesson_grammar.pattern_id > language_module.grammar_patterns.id
Ref: course_module.lesson_grammar_points.grammar_point_id > language_module.grammar_points.id
Ref: course_module.lesson_grammar_points.lesson_id > course_module.lessons.id
Ref: course_module.lesson_kanji.lesson_id > course_module.lessons.id
Ref: course_module.lesson_kanji.kanji_id > language_module.kanji.id
Ref: course_module.lesson_progress.lesson_id > course_module.lessons.id
Ref: course_module.lesson_progress.student_id > users_module.users.id
Ref: course_module.lesson_vocabulary.vocabulary_id > language_module.vocabulary.id
Ref: course_module.lesson_vocabulary.lesson_id > course_module.lessons.id
Ref: course_module.lessons.created_by > users_module.users.id
Ref: course_module.lessons.reading_article_id > practice_module.articles.id
Ref: course_module.lessons.unit_id > course_module.units.id
Ref: course_module.lessons.skill_id > course_module.skills.id
Ref: course_module.lessons.course_id > course_module.courses.id
Ref: course_module.units.course_id > course_module.courses.id
