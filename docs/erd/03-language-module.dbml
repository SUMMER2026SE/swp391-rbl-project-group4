// 03-language-module.dbml — schema "language_module" (Kho từ vựng / kanji / ngữ pháp & bài đăng)
// Kizuna Nihongo — dán trực tiếp vào https://dbdiagram.io

// Quan hệ đa hình (không có FK cứng):
//   study_list_items.item_id → vocabulary.id | kanji.id | grammar_points.id (tùy study_list_posts.type)

Table language_module.grammar_patterns {
  id uuid [pk, default: `gen_random_uuid()`]
  pattern varchar(200) [not null]
  structure varchar(500)
  meaning_vi text [not null]
  meaning_en text
  jlpt_level_id smallint [not null]
  usage_notes text
  example_sentences jsonb
  related_patterns jsonb
  created_by uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  is_public boolean [not null, default: true]
}

Table language_module.grammar_points {
  id uuid [pk, default: `gen_random_uuid()`]
  title text [not null]
  title_ja text
  meaning_vi text [not null]
  explanation text
  example_sentence text
  level text
  created_at timestamptz [default: `now()`]
  created_by uuid
}

Table language_module.grammar_set_items {
  set_id uuid [not null]
  pattern_id uuid [not null]
  sort_order smallint [not null, default: 0]

  indexes {
    (set_id, pattern_id) [pk]
  }
}

Table language_module.grammar_sets {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(200) [not null]
  description text
  created_by uuid [not null]
  jlpt_level_id smallint
  is_public boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  view_count int [not null, default: 0]
}

Table language_module.jlpt_levels {
  id smallint [pk]
  name char(2) [unique, not null]
  description varchar(100)
}

Table language_module.kanji {
  id uuid [pk, default: `gen_random_uuid()`]
  character char(1) [unique, not null]
  stroke_count smallint
  onyomi varchar(200)
  kunyomi varchar(200)
  meaning_vi text [not null]
  meaning_en text
  jlpt_level_id smallint
  radical varchar(10)
  stroke_order_url varchar(500)
  example_words jsonb
  mnemonic_vi text
  created_at timestamptz [not null, default: `now()`]
  han_viet varchar
  lesson_id uuid
  created_by uuid
  is_public boolean [not null, default: true]
}

Table language_module.kanji_set_items {
  set_id uuid [not null]
  kanji_id uuid [not null]
  sort_order smallint [not null, default: 0]

  indexes {
    (set_id, kanji_id) [pk]
  }
}

Table language_module.kanji_sets {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(200) [not null]
  description text
  created_by uuid [not null]
  jlpt_level_id smallint
  topic_id int
  is_public boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  view_count int [not null, default: 0]
}

Table language_module.study_list_items {
  id uuid [pk, default: `gen_random_uuid()`]
  post_id uuid [not null]
  item_id uuid [not null]
  sort_order int [not null, default: 0]
  created_at timestamptz [default: `now()`]

  indexes {
    (post_id, item_id) [unique]
  }
}

Table language_module.study_list_posts {
  id uuid [pk, default: `gen_random_uuid()`]
  list_type text [not null]
  title text [not null]
  description text
  creator_type varchar(10) [not null]
  created_by uuid [not null]
  view_count int [not null, default: 0]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]
  level text
  topic text
  is_locked boolean [not null, default: false]
  lock_note text
}

Table language_module.teacher_kanji {
  id uuid [pk, default: `gen_random_uuid()`]
  teacher_id uuid [not null]
  character text [not null]
  reading_on "text[]"
  reading_kun "text[]"
  meaning_vi text [not null]
  stroke_count int
  level text
  status text [not null, default: 'draft']
  admin_note text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table language_module.teacher_vocabulary {
  id uuid [pk, default: `gen_random_uuid()`]
  teacher_id uuid [not null]
  kanji text
  reading text [not null]
  meaning_vi text [not null]
  meaning_ja text
  level text
  type text
  example_sentence text
  status text [not null, default: 'draft']
  admin_note text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  han_viet varchar(200)
}

Table language_module.topics {
  id int [pk, increment]
  name_vi varchar(100) [not null]
  name_en varchar(100)
  name_ja varchar(100)
  icon_url varchar(500)
  parent_id int
}

Table language_module.vocabulary {
  id uuid [pk, default: `gen_random_uuid()`]
  word varchar(100) [not null]
  reading varchar(100) [not null]
  romaji varchar(100)
  meaning_vi text [not null]
  meaning_en text
  part_of_speech varchar(30)
  jlpt_level_id smallint
  example_sentence text
  example_sentence_vi text
  audio_url varchar(500)
  image_url varchar(500)
  created_at timestamptz [not null, default: `now()`]
  lesson_id uuid
  topic varchar
  created_by uuid
  is_public boolean [not null, default: true]
  han_viet varchar(200)
}

Table language_module.vocabulary_set_items {
  set_id uuid [not null]
  vocabulary_id uuid [not null]
  sort_order smallint [not null, default: 0]

  indexes {
    (set_id, vocabulary_id) [pk]
  }
}

Table language_module.vocabulary_sets {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(200) [not null]
  description text
  created_by uuid [not null]
  jlpt_level_id smallint
  is_public boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  view_count int [not null, default: 0]
}

Table language_module.vocabulary_topics {
  vocabulary_id uuid [not null]
  topic_id int [not null]

  indexes {
    (vocabulary_id, topic_id) [pk]
  }
}

// ─── Bảng tham chiếu ở schema khác (stub, chỉ để vẽ quan hệ) ───

Table auth.users {
  id uuid [pk]

  Note: 'Supabase Auth (auth.users) — nguồn định danh gốc'
}

Table users_module.users {
  id uuid [pk]

  Note: 'Bảng thuộc schema users_module — xem file 01-users-module.dbml'
}

// ─── Quan hệ ───

Ref: language_module.grammar_patterns.jlpt_level_id > language_module.jlpt_levels.id
Ref: language_module.grammar_patterns.created_by > users_module.users.id
Ref: language_module.grammar_set_items.pattern_id > language_module.grammar_patterns.id
Ref: language_module.grammar_set_items.set_id > language_module.grammar_sets.id
Ref: language_module.grammar_sets.created_by > users_module.users.id
Ref: language_module.grammar_sets.jlpt_level_id > language_module.jlpt_levels.id
Ref: language_module.kanji.jlpt_level_id > language_module.jlpt_levels.id
Ref: language_module.kanji.created_by > auth.users.id
Ref: language_module.kanji_set_items.set_id > language_module.kanji_sets.id
Ref: language_module.kanji_set_items.kanji_id > language_module.kanji.id
Ref: language_module.kanji_sets.created_by > users_module.users.id
Ref: language_module.kanji_sets.jlpt_level_id > language_module.jlpt_levels.id
Ref: language_module.kanji_sets.topic_id > language_module.topics.id
Ref: language_module.study_list_items.post_id > language_module.study_list_posts.id
Ref: language_module.study_list_posts.created_by > users_module.users.id
Ref: language_module.teacher_kanji.teacher_id > auth.users.id
Ref: language_module.teacher_vocabulary.teacher_id > auth.users.id
Ref: language_module.topics.parent_id > language_module.topics.id
Ref: language_module.vocabulary.jlpt_level_id > language_module.jlpt_levels.id
Ref: language_module.vocabulary.created_by > auth.users.id
Ref: language_module.vocabulary_set_items.vocabulary_id > language_module.vocabulary.id
Ref: language_module.vocabulary_set_items.set_id > language_module.vocabulary_sets.id
Ref: language_module.vocabulary_sets.jlpt_level_id > language_module.jlpt_levels.id
Ref: language_module.vocabulary_sets.created_by > users_module.users.id
Ref: language_module.vocabulary_topics.topic_id > language_module.topics.id
Ref: language_module.vocabulary_topics.vocabulary_id > language_module.vocabulary.id
